# =============================================================================
# SOLENE — Environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — full access, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
# Public base URL, used to build memorial links and share messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (assinatura do SaaS) ---------------------------------------------
# Dashboard do Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Developers -> Webhooks -> assinatura do endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# IDs de preço recorrentes (Products -> Price) para cada plano
STRIPE_PRICE_ESSENCIAL=price_xxx
STRIPE_PRICE_PRO=price_xxx

# --- Cakto (gateway alternativo) ---------------------------------------------
# Links de checkout (hospedados pela Cakto) de cada plano
CAKTO_CHECKOUT_ESSENCIAL=https://pay.cakto.com.br/xxxx
CAKTO_CHECKOUT_PRO=https://pay.cakto.com.br/yyyy
# Segredo do webhook (configurado no painel da Cakto) — valida /api/cakto/webhook
CAKTO_WEBHOOK_SECRET=seu-segredo
# (Opcional) ids de oferta para mapear o plano no webhook, se a Cakto enviar
# CAKTO_OFFER_ESSENCIAL=
# CAKTO_OFFER_PRO=
