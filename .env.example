# =============================================================================
# SOLENE — Environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — full access, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
# Public base URL, used to build memorial links and share messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payment gateways (future — layer is provider-agnostic) ------------------
# Fill in only when connecting a real gateway (Asaas / Mercado Pago / Stripe).
# PAYMENTS_PROVIDER=asaas
# PAYMENTS_API_KEY=
# PAYMENTS_WEBHOOK_SECRET=
